---
interface Props {
	summary: string;
	/** small cyan label, e.g. "РАСКРЫТЬ" */
	hint?: string;
	/** dim text on the right, e.g. "4 тематики" */
	meta?: string;
	open?: boolean;
}

const { summary, hint, meta, open = false } = Astro.props;
---

<details class="accordion panel" open={open}>
	<summary>
		<span class="summary-main">
			{hint && <span class="hint eyebrow">{hint}</span>}
			<span class="summary-text">{summary}</span>
			{meta && <span class="meta label">{meta}</span>}
		</span>
		<svg
			class="chev"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<polyline points="6 9 12 15 18 9"></polyline>
		</svg>
	</summary>
	<div class="accordion-body">
		<slot />
	</div>
</details>

<style>
	.accordion {
		overflow: hidden;
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.15rem 1.4rem;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: 2px solid var(--violet);
		outline-offset: -2px;
	}

	.summary-main {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.summary-text {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: var(--text-md);
		color: var(--gray-0);
	}

	.chev {
		width: 1.15rem;
		height: 1.15rem;
		flex-shrink: 0;
		color: var(--violet);
		transition: transform var(--theme-transition);
	}
	.accordion[open] .chev {
		transform: rotate(180deg);
	}

	.accordion-body {
		padding: 1.25rem 1.4rem 1.4rem;
		border-top: 1px solid var(--line);
	}
</style>

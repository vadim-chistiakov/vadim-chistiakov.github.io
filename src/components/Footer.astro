---
import Icon from './Icon.astro';
import { site, social } from '../data/siteConfig';
import type { Lang } from '../i18n/config';

interface Props {
	lang?: Lang;
}
const { lang = 'ru' } = Astro.props;
void lang;
const year = new Date().getFullYear();
---

<footer>
	<div class="wrapper inner">
		<p class="copy label">© {year} {site.name} · {site.legalName}</p>
		<div class="socials">
			{social.map((s) => (
				<a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
					<Icon icon={s.icon} />
				</a>
			))}
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--line);
		padding-block: 1.9rem;
		margin-top: auto;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		font-size: 1.15rem;
		color: var(--gray-400);
	}
	.socials a {
		color: inherit;
		transition: color var(--theme-transition);
	}
	.socials a:hover {
		color: var(--violet);
	}
</style>

---
import Icon from './Icon.astro';
import { getNavItems } from '../data/nav';
import { links, site, social } from '../data/siteConfig';
import type { Lang } from '../i18n/config';
import { languages, stripLang, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
	lang?: Lang;
}
const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);

const logical = stripLang(Astro.url.pathname);
// Section anchors only exist on the one-page homepage. On any other page (e.g. /mentorstvo/)
// they must point back to the homepage first, or the links silently do nothing.
const isHome = logical === '/';
const homeHref = localizePath('/', lang);
const navItems = getNavItems(lang).map((item) => ({
	...item,
	href: isHome ? item.href : `${homeHref}${item.href}`,
}));
const langLinks = (Object.keys(languages) as Lang[]).map((l) => ({
	code: languages[l],
	href: localizePath(logical, l),
	active: l === lang,
}));
---

<nav>
	<div class="wrapper nav-inner">
		<a href={localizePath('/', lang)} class="brand">
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="4 17 10 11 4 5"></polyline>
					<line x1="12" y1="19" x2="20" y2="19"></line>
				</svg>
			</span>
			<span class="brand-name">{site.name}</span>
		</a>

		<ul class="nav-links">
			{navItems.map((item) => (
				<li><a href={item.href}>{item.label}</a></li>
			))}
		</ul>

		<div class="nav-right">
			<div class="lang" role="group" aria-label="Language">
				{langLinks.map((l) => (
					<a href={l.href} class:list={['lang-link', { active: l.active }]} aria-current={l.active ? 'true' : undefined}>{l.code}</a>
				))}
			</div>
			<a class="btn btn-primary nav-cta" href={links.boosty} target="_blank" rel="noopener">{t('nav.join')}</a>
		</div>

		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false" aria-controls="mobile-menu">
					<span class="sr-only">{t('nav.menu')}</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>

	<div id="mobile-menu" class="mobile-menu" hidden>
		<ul>
			{navItems.map((item) => (
				<li><a href={item.href} class="m-link">{item.label}</a></li>
			))}
		</ul>
		<div class="lang">
			{langLinks.map((l) => (
				<a href={l.href} class:list={['lang-link', { active: l.active }]}>{l.code}</a>
			))}
		</div>
		<a class="btn btn-primary" href={links.boosty} target="_blank" rel="noopener">{t('nav.joinBoosty')}</a>
		<div class="m-socials">
			{social.map((s) => (
				<a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
					<Icon icon={s.icon} />
				</a>
			))}
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		connectedCallback() {
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;
			const menu = document.getElementById('mobile-menu')!;

			const setExpanded = (open: boolean) => {
				btn.setAttribute('aria-expanded', String(open));
				menu.hidden = !open;
				document.body.style.overflow = open ? 'hidden' : '';
			};

			btn.addEventListener('click', () => setExpanded(menu.hidden));
			menu.addEventListener('click', (e) => {
				if ((e.target as HTMLElement).closest('a')) setExpanded(false);
			});

			const mq = window.matchMedia('(min-width: 60em)');
			const sync = (e: MediaQueryList | MediaQueryListEvent) => {
				btn.hidden = e.matches;
				if (e.matches) setExpanded(false);
			};
			sync(mq);
			mq.addEventListener('change', sync);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--line);
		background: hsla(var(--gray-999-basis), 0.65);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 4.25rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--gray-0);
		text-decoration: none;
		flex-shrink: 0;
	}
	.brand-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: -0.02em;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 0.5rem;
		color: #0a0b0f;
		background: var(--gradient-brand);
	}
	.brand-mark svg {
		width: 1rem;
		height: 1rem;
	}

	.nav-links {
		display: none;
		list-style: none;
		gap: 1.4rem;
		margin: 0;
		padding: 0;
	}
	.nav-links a {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--gray-300);
		text-decoration: none;
		transition: color var(--theme-transition);
	}
	.nav-links a:hover {
		color: var(--gray-0);
	}

	.nav-right {
		display: none;
		align-items: center;
		gap: 1rem;
	}

	.lang {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.75rem;
	}
	.lang-link {
		padding: 0.25rem 0.4rem;
		border-radius: 0.4rem;
		color: var(--gray-400);
		text-decoration: none;
		transition: color var(--theme-transition);
	}
	.lang-link:hover {
		color: var(--gray-100);
	}
	.lang-link.active {
		color: var(--violet);
	}

	.nav-cta {
		padding: 0.6rem 1.15rem;
		font-size: 0.8125rem;
	}

	.menu-button {
		display: flex;
		border: 0;
		border-radius: 999px;
		padding: 0.5rem;
		font-size: 1.35rem;
		color: var(--gray-200);
		background: var(--panel-solid);
		box-shadow: inset 0 0 0 1px var(--line);
		cursor: pointer;
	}
	.menu-button[hidden] {
		display: none;
	}

	.mobile-menu {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.5rem;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	.mobile-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.m-link {
		display: block;
		padding: 0.5rem 0;
		font-size: var(--text-md);
		color: var(--gray-100);
		text-decoration: none;
	}
	.m-socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: 1.25rem;
		color: var(--violet);
	}
	.m-socials a {
		color: inherit;
	}

	@media (min-width: 60em) {
		.nav-links,
		.nav-right {
			display: flex;
		}
		.nav-inner {
			height: 4.75rem;
		}
	}
</style>

---
import { links } from '../../data/siteConfig';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}
const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);
---

<section class="final">
	<div class="wrapper">
		<div class="panel card">
			<h2>{t('final.title')}</h2>
			<p>{t('final.text')}</p>
			<a class="btn btn-primary" href={links.boosty} target="_blank" rel="noopener">
				{t('final.cta')}
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
			</a>
		</div>
	</div>
</section>

<style>
	.final {
		padding-block: clamp(3rem, 7vw, 5rem);
	}
	.card {
		padding: clamp(2.25rem, 6vw, 3.75rem);
		text-align: center;
		border-color: var(--line-bright);
		background:
			radial-gradient(120% 140% at 50% 0%, rgba(157, 123, 255, 0.16), transparent 60%),
			var(--panel);
		box-shadow: 0 0 100px -30px rgba(157, 123, 255, 0.6);
	}
	.card h2 {
		font-size: clamp(1.6rem, 5vw, 2.125rem);
	}
	.card p {
		margin-top: 0.75rem;
		color: var(--gray-300);
	}
	.card .btn {
		margin-top: 1.6rem;
	}
	.card svg {
		width: 1rem;
		height: 1rem;
	}
</style>

---
import { getCommunityStats } from '../../data/community';
import { links } from '../../data/siteConfig';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}
const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);
const stats = getCommunityStats(lang);
---

<header class="wrapper hero">
	<div class="banner">
		<img
			class="cover"
			src="/assets/main_cover.webp"
			alt="The IT Community — Develop · Grow · Get hired"
			width="2103"
			height="748"
			fetchpriority="high"
		/>
	</div>

	<div class="hero-copy">
		<p class="eyebrow">{t('hero.eyebrow')}</p>
		<h1>{t('hero.title.pre')}<span class="brand-gradient">{t('hero.title.accent')}</span></h1>
		<p class="hero-lead">
			<strong>{t('hero.lead.brand')}</strong>{t('hero.lead.rest')}
		</p>
		<div class="hero-cta">
			<a class="btn btn-primary" href={links.boosty} target="_blank" rel="noopener">
				{t('hero.cta.primary')}
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
			</a>
			<a class="btn btn-ghost" href="#community">{t('hero.cta.secondary')}</a>
		</div>
	</div>

	<ul class="stats">
		{stats.map((s) => (
			<li>
				<span class="stat-v">{s.value}</span>
				<span class="stat-l label">{s.label}</span>
			</li>
		))}
	</ul>
</header>

<style>
	.hero {
		padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 8vw, 5rem);
	}

	.banner {
		position: relative;
		border-radius: 24px;
		overflow: hidden;
		border: 1px solid var(--line-bright);
		background: #0c0b22;
		box-shadow:
			0 60px 150px -55px rgba(157, 123, 255, 0.65),
			inset 0 0 0 1px rgba(255, 255, 255, 0.04);
	}
	.cover {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero-copy {
		max-width: 60ch;
		margin-top: clamp(2rem, 6vw, 3rem);
	}
	.hero-copy h1 {
		margin-top: 1.1rem;
		font-size: clamp(2rem, 6vw, 2.875rem);
		line-height: 1.1;
	}
	.hero-lead {
		margin-top: 1.25rem;
		font-size: var(--text-md);
		line-height: 1.6;
		color: var(--gray-300);
	}
	.hero-lead strong {
		color: var(--gray-100);
		font-weight: 600;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 1.85rem;
	}
	.hero-cta svg {
		width: 1rem;
		height: 1rem;
	}

	.stats {
		list-style: none;
		margin: clamp(2rem, 5vw, 2.75rem) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem 0.5rem;
	}
	.stat-v {
		display: block;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.4rem, 4vw, 1.75rem);
		letter-spacing: -0.03em;
		color: #fff;
	}
	.stat-l {
		display: block;
		margin-top: 0.35rem;
	}

	@media (min-width: 50em) {
		.stats {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>

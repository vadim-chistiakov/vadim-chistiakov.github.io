---
import Section from '../Section.astro';
import { getMentorshipSummary } from '../../data/mentorship';
import { links } from '../../data/siteConfig';
import type { Lang } from '../../i18n/config';
import { localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang?: Lang;
}
const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);
const s = getMentorshipSummary(lang);
const detailHref = localizePath('/mentorstvo/', lang);
---

<Section id="mentorship" number={t('mentorship.num')} eyebrow={t('mentorship.eyebrow')} title={t('mentorship.title')}>
	<div class="panel card">
		<img class="art" src="/assets/Mentee-tier.webp" alt={t('mentorship.title')} loading="lazy" />
		<div class="body">
			<div>
				<h3>{t('mentorship.h.mentorship')}</h3>
				<p>{s.mentorship}</p>
			</div>
			<div>
				<h3>{t('mentorship.h.consult')}</h3>
				<p>
					{s.consultation}
					<span class="price">{s.consultationPrice}</span>
					<span class="label">{s.consultationUnit}{t('mentorship.demo')}</span>
				</p>
			</div>
			<div class="spacer"></div>
			<div class="cta">
				<a class="btn btn-primary" href={links.mentorshipBot} target="_blank" rel="noopener">
					{t('mentorship.cta.bot')}
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.6 13 1.8 11.5c-1-.3-1-1 .2-1.5l18.6-7.2c.9-.3 1.6.2 1.3 1.5Z"></path></svg>
				</a>
				<a class="btn btn-ghost" href={detailHref}>
					{t('mentorship.cta.detail')}
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
				</a>
			</div>
			<p class="label foot">{t('mentorship.foot')}</p>
		</div>
	</div>
</Section>

<style>
	.card {
		margin-top: 1.9rem;
		overflow: hidden;
		border-color: var(--line-bright);
		box-shadow: 0 0 90px -28px rgba(157, 123, 255, 0.55);
		display: grid;
		grid-template-columns: 1fr;
	}
	.art {
		width: 100%;
		height: 200px;
		object-fit: contain;
		object-position: center;
		background: var(--panel);
		display: block;
		border-bottom: 1px solid var(--line);
	}
	.body {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.body h3 {
		font-size: 1.2rem;
	}
	.body p {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--gray-300);
	}
	.price {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		color: #fff;
	}
	.spacer {
		flex-grow: 1;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}
	.cta svg {
		width: 0.95rem;
		height: 0.95rem;
	}
	.foot {
		line-height: 1.5;
	}

	@media (min-width: 50em) {
		.card {
			grid-template-columns: 320px 1fr;
		}
		.art {
			height: 100%;
			border-bottom: 0;
			border-right: 1px solid var(--line);
		}
		.body {
			padding: 2.25rem 2.375rem;
		}
	}
</style>
